# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random string, minimal 32 karakter. Buat dengan: openssl rand -base64 48
SESSION_SECRET=

# Opsional: URL aplikasi (jika kosong dipakai host request). Contoh: https://gitmage.vercel.app
APP_URL=

# Opsional: integrasi Vercel (https://vercel.com/account/tokens)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
